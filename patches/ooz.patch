# Patch do nw-port sobre powzix/ooz 05038060aa68f9187ae9923b2388ca8db40e58d1 (GPL-3.0): exporta OodleLZ_Decompress
# para o nwbt carregar libooz.so/ooz.dll no lugar da DLL do Oodle, e compila no GCC e no MSVC. Aplicado por tools/build_ooz.py.
diff --git a/kraken.cpp b/kraken.cpp
index a4983d6..9ff1fa7 100644
--- a/kraken.cpp
+++ b/kraken.cpp
@@ -4152,301 +4152,17 @@ FAIL:
 // The decompressor will write outside of the target buffer.
 #define SAFE_SPACE 64
 
-void error(const char *s, const char *curfile = NULL) {
-  if (curfile)
-    fprintf(stderr, "%s: ", curfile);
-  fprintf(stderr, "%s\n", s);
-  exit(1);
+// Ponto de entrada com a mesma assinatura do OodleLZ_Decompress da DLL,
+// para o nwbt carregar libooz.so no lugar de oo2core_*_win64.dll.
+// O decoder escreve até 64 bytes além do destino, por isso o buffer temporário.
+extern "C" OOZ_EXPORT
+intptr_t OodleLZ_Decompress(const byte *src, intptr_t src_len, byte *dst, intptr_t dst_len,
+                            intptr_t, intptr_t, intptr_t, intptr_t, intptr_t, intptr_t,
+                            intptr_t, intptr_t, intptr_t, intptr_t) {
+  byte *tmp = (byte *)malloc(dst_len + 64);
+  if (!tmp) return 0;
+  int n = Kraken_Decompress(src, src_len, tmp, dst_len);
+  if (n > 0) memcpy(dst, tmp, n);
+  free(tmp);
+  return n < 0 ? 0 : n;
 }

@@ -0,0 +1,22 @@
+package env
+
+import (
+	"os"
+	"path/filepath"
+	"reflect"
+	"testing"
+)
+
+func TestAppendToPATH(t *testing.T) {
+	t.Setenv("PATH", "existing tool directory")
+	AppendToPATH("new tool directory")
+	want := []string{"existing tool directory", "new tool directory"}
+	if got := os.Getenv("PATH"); !reflect.DeepEqual(filepath.SplitList(got), want) {
+		t.Fatalf("PATH entries: %#v", filepath.SplitList(got))
+	}
+	t.Setenv("PATH", "")
+	AppendToPATH("only directory")
+	if got := os.Getenv("PATH"); got != "only directory" {
+		t.Fatalf("empty PATH: %q", got)
+	}
+}

new file mode 100644
index 0000000..fd7f0e6
--- /dev/null
+++ b/tools/nwbt/utils/oodle_windows_test.go
@@ -0,0 +1,51 @@
+package utils
+
+import (
+	"bytes"
+	"os"
+	"path/filepath"
+	"testing"
+)
+
+func TestOodleWindowsOverride(t *testing.T) {
+	dir := t.TempDir()
+	p := filepath.Join(dir, "decoder with spaces.dll")
+	if err := os.WriteFile(p, []byte("placeholder"), 0600); err != nil {
+		t.Fatal(err)
+	}
+	t.Setenv("NWBT_OODLE", p)
+	lib := oodle{}
+	if got, ok := lib.Check(); !ok || got != p {
+		t.Fatalf("Check: %q, %v", got, ok)
+	}
+	t.Setenv("NWBT_OODLE", filepath.Join(dir, "missing.dll"))
+	if _, ok := lib.Check(); ok {
+		t.Fatal("missing override silently fell back")
+	}
+	t.Setenv("NWBT_OODLE", dir)
+	if _, ok := lib.Check(); ok {
+		t.Fatal("accepted directory")
+	}
+}
+
+func TestOozWindowsStoredBlock(t *testing.T) {
+	dll := os.Getenv("NWBT_TEST_OOZ")
+	if dll == "" {
+		t.Skip("set NWBT_TEST_OOZ to the built ooz.dll")
+	}
+	t.Setenv("NWBT_OODLE", dll)
+	payload := []byte("native Windows Kraken ABI test")
+	// Kraken header: restart + stored (uncompressed) block, decoder 6.
+	input := append([]byte{0xcc, 6}, payload...)
+	output := make([]byte, len(payload))
+	lib := oodle{}
+	n, err := lib.Decompress(input, len(input), output, len(output))
+	if err != nil || n != len(payload) || !bytes.Equal(output, payload) {
+		t.Fatalf("Decompress: n=%d err=%v output=%q", n, err, output)
+	}
+	input[0] = 0 // invalid header must return failure through the native ABI.
+	n, err = lib.Decompress(input, len(input), output, len(output))
+	if err != nil || n != 0 {
+		t.Fatalf("invalid header: n=%d err=%v", n, err)
+	}
+}

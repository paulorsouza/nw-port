diff --git a/tools/nwbt/utils/datafile.go b/tools/nwbt/utils/datafile.go
new file mode 100644
index 0000000..cd62ed5
--- /dev/null
+++ b/tools/nwbt/utils/datafile.go
@@ -0,0 +1,29 @@
+package utils
+
+import (
+	"fmt"
+	"os"
+	"path/filepath"
+)
+
+// ResolveDataFile resolves data, without executable permissions or PATHEXT.
+// Keep PATH lookup for existing installations that store RTTI JSON there.
+func ResolveDataFile(name string) (string, error) {
+	candidates := []string{name}
+	if filepath.Base(name) == name {
+		if exe, err := os.Executable(); err == nil {
+			candidates = append(candidates, filepath.Join(filepath.Dir(exe), name))
+		}
+		for _, dir := range filepath.SplitList(os.Getenv("PATH")) {
+			if dir != "" {
+				candidates = append(candidates, filepath.Join(dir, name))
+			}
+		}
+	}
+	for _, p := range candidates {
+		if info, err := os.Stat(p); err == nil && info.Mode().IsRegular() {
+			return filepath.Abs(p)
+		}
+	}
+	return "", fmt.Errorf("data file not found: %s", name)
+}
diff --git a/tools/nwbt/utils/datafile_test.go b/tools/nwbt/utils/datafile_test.go
new file mode 100644
index 0000000..971b139
--- /dev/null
+++ b/tools/nwbt/utils/datafile_test.go
@@ -0,0 +1,30 @@
+package utils
+
+import (
+	"os"
+	"path/filepath"
+	"testing"
+)
+
+func TestResolveDataFile(t *testing.T) {
+	dir := t.TempDir()
+	p := filepath.Join(dir, "types with spaces.json")
+	if err := os.WriteFile(p, []byte("{}"), 0600); err != nil {
+		t.Fatal(err)
+	}
+	got, err := ResolveDataFile(p)
+	if err != nil || got != p {
+		t.Fatalf("got %q, %v", got, err)
+	}
+	t.Setenv("PATH", dir)
+	got, err = ResolveDataFile(filepath.Base(p))
+	if err != nil || got != p {
+		t.Fatalf("PATH lookup: %q, %v", got, err)
+	}
+	if _, err := ResolveDataFile(dir); err == nil {
+		t.Fatal("accepted a directory")
+	}
+	if _, err := ResolveDataFile(filepath.Join(dir, "missing.json")); err == nil {
+		t.Fatal("accepted missing file")
+	}
+}

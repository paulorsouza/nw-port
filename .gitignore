# Nada que venha da instalação do jogo entra no repositório: cada um extrai da própria cópia (docs/SETUP.md).
extract/
# Caminhos desta máquina (modelo em local.env.example).
local.env
# Cache local das respostas da engenharia reversa (agente nw-re); o port não depende dele (re-local/README.md).
re-local/*
!re-local/README.md
previews/
reference/
# Prints do jogo original para inspiração das telas (fica só o índice no git).
inspiracao/*
!inspiracao/README.md
.nwbt/
*.nwbt/
# Código de terceiros clonado (versões e build em docs/FERRAMENTAS.md).
vendor/
__pycache__/
# Ferramentas baixadas ou compiladas pelo setup (tools/linux/get_tools.sh, tools/windows/build_*.ps1).
bin/

# Unreal: binários, caches e todo o Content (gerado pelos imports a partir dos assets do jogo).
unreal/NWPort/Binaries/
unreal/NWPort/Intermediate/
unreal/NWPort/Saved/
unreal/NWPort/DerivedDataCache/
unreal/NWPort/Build/
unreal/NWPort/Content/**
!unreal/NWPort/Content/**/
# Feitos à mão no editor (grafo das Animation Blueprints): não há script que os recrie.
!unreal/NWPort/Content/NW/sword_shield/ABP_NW.uasset
!unreal/NWPort/Content/NW/lost_sword/ABP_Lost.uasset
# Data/ é gerado pelos tools/make_*.py e ui_build_*.py (textos e tabelas do jogo).
unreal/NWPort/Data/

# Backend e deploy: build e segredos.
backend/target/
deploy/build/
deploy/.env
*.env.local

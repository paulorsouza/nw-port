# Nothing from the game install goes into the repository: everyone extracts from their own copy (docs/setup.md).
extract/
# Paths for this machine (template in local.env.example).
local.env
# Local cache of reverse-engineering answers (nw-re agent); the port does not depend on it (re-local/README.md).
re-local/*
!re-local/README.md
previews/
reference/
# Screenshots of the original game as reference for the screens (only the index is in git).
inspiracao/*
!inspiracao/README.md
.nwbt/
*.nwbt/
# Cloned third-party code (versions and build in docs/tech/tools.md).
vendor/
__pycache__/
# Tools downloaded or built by the setup (tools/linux/get_tools.sh, tools/windows/build_*.ps1).
bin/

# Unreal: binaries, caches and all of Content (generated by the imports from the game assets).
unreal/NWPort/Binaries/
unreal/NWPort/Intermediate/
unreal/NWPort/Saved/
unreal/NWPort/DerivedDataCache/
unreal/NWPort/Build/
unreal/NWPort/Content/**
!unreal/NWPort/Content/**/
# Made by hand in the editor (Animation Blueprint graphs): no script recreates them.
!unreal/NWPort/Content/NW/sword_shield/ABP_NW.uasset
!unreal/NWPort/Content/NW/lost_sword/ABP_Lost.uasset
# Data/ is generated by tools/make_*.py and ui_build_*.py (game texts and tables).
unreal/NWPort/Data/

# Backend and deploy: build output and secrets.
backend/target/
deploy/build/
deploy/.env
*.env.local

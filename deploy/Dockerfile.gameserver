# Game server (Unreal dedicated, Linux). Takes the folder packaged by tools/linux/package_server.sh in
# build/LinuxServer — game content extracted from the packager's own install: private image, do not publish.
FROM ubuntu:24.04
# Unreal ships its own libcurl; the "ubuntu" user (UID 1000) already comes with the image.
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates && rm -rf /var/lib/apt/lists/*
COPY --chown=ubuntu:ubuntu build/LinuxServer /srv/nw
USER ubuntu
WORKDIR /srv/nw
EXPOSE 7777/udp
ENTRYPOINT ["/srv/nw/NWPortServer.sh"]
CMD ["/Game/NW/Maps/L_SouthWindsward", "-log", "-port=7777"]

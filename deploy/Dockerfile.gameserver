# Servidor de jogo (Unreal dedicado, Linux). Recebe a pasta empacotada por tools/linux/package_server.sh em
# build/LinuxServer — conteúdo do jogo extraído da instalação de quem empacota: imagem privada, não publicar.
FROM ubuntu:24.04
# A Unreal traz a própria libcurl; o usuário "ubuntu" (UID 1000) já vem na imagem.
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates && rm -rf /var/lib/apt/lists/*
COPY --chown=ubuntu:ubuntu build/LinuxServer /srv/nw
USER ubuntu
WORKDIR /srv/nw
EXPOSE 7777/udp
ENTRYPOINT ["/srv/nw/NWPortServer.sh"]
CMD ["/Game/NW/Maps/L_SouthWindsward", "-log", "-port=7777"]

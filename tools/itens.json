 "passo_gs": [
  {"ate": 10, "min": -10, "max": 15},
  {"ate": 25, "min": -10, "max": 10},
  {"min": -20, "max": 10}
 ],
 "_custos": "provisional: reroll attribute = 2, reroll GS = 2, unbind = 2 + quality/10 of one recipe material, chosen on the screen (materiais_melhoria: 'receita' = ingredient index, or 'item' = id; optional 'passo_gs' changes the step for that material); removing a gem = 1 raw gem of the same type and tier",

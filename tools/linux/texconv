#!/usr/bin/env bash
# Chama o texconv.exe (DirectXTex) pelo wine, convertendo caminhos absolutos para Z:\.
here="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
exe="${TEXCONV_EXE:-$here/../../bin/texconv.exe}"
args=()
for a in "$@"; do
  if [[ $a == /* ]]; then args+=("Z:${a//\//\\}"); else args+=("$a"); fi
done
export WINEDEBUG=-all
export WINEPREFIX="${WINEPREFIX:-$HOME/.local/share/nw-port-wine}"
exec wine "$exe" "${args[@]}"

# Copy to local.env (not tracked) and set what the setup could not find by itself.
# Environment variables win over this file. Paths may start with ~.

# New World install (the folder that has assets/ and Bin64/). Default: found in your Steam libraries.
#NW_GAME=~/.steam/steam/steamapps/common/New World

# Unreal Engine 5.8.3 (the folder that has Engine/). Default: common install folders.
#NW_UE=~/UnrealEngine/5.8

# Unreal Engine 5.8.3 built from source (only to build the dedicated server: tools/linux/package_server.sh).
#NW_UE_SOURCE=~/UnrealEngine/src-5.8.3

# Blender 5.2 executable. Default: PATH or ~/.local/opt/blender-*/blender.
#NW_BLENDER=

# Folder with the asset zips (tools/assets_export.py / assets_import.py). Default: ~/nw-port-assets.
#NW_ASSETS=~/nw-port-assets

# Public host of nw-core for the network test through Cloudflare Tunnel (tools/linux/network.sh).
#NW_NETWORK_HOST=core.example.com
